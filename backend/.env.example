# =============================================================================
# ORION Backend Environment Configuration Template
# Copy this file to backend/.env and adjust values for your environment.
# All values shown below are non-secret defaults or placeholders.
# =============================================================================

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/orion
# TEST_DATABASE_URL=sqlite+aiosqlite:///./orion-test.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication Secrets
SECRET_KEY=change-me-in-production-to-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS & Network Target Configuration
ORION_CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "https://orion-one-alpha.vercel.app"]
ORION_ALLOW_PRIVATE_TARGETS=true

# AI / LLM Provider Configuration (OpenAI, Anthropic via proxy, OpenRouter, Groq, Local Models)
ORION_LLM_API_KEY=your-api-key-here
ORION_LLM_BASE_URL=https://openrouter.ai/api/v1
ORION_LLM_MODEL=openai/gpt-4o-mini

# Redis & Celery Task Queue Configuration
ORION_REDIS_URL=redis://localhost:6379/0
ORION_CELERY_BROKER_URL=redis://localhost:6379/1
ORION_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# SMTP / Email Notification Configuration
ORION_SMTP_HOST=
ORION_SMTP_PORT=587
ORION_SMTP_USERNAME=
ORION_SMTP_PASSWORD=
ORION_SMTP_FROM_EMAIL=
