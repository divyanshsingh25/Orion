# =============================================================================
# ORION Root .gitignore
# Protects secrets, databases, logs, build artifacts, and virtual environments
# =============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/

# Dependencies & Build Artifacts
**/node_modules/
**/dist/
node_modules/
dist/

# SQLite Databases & Lock/Journal Files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.backup.*

# Python Cache & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs & Process Outputs
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ORION Application Storage (Preserve directory structure via .gitkeep)
storage/backups/*
!storage/backups/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
backend/storage/backups/*
!backend/storage/backups/.gitkeep
backend/storage/reports/*
!backend/storage/reports/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep
**/storage/backups/*
!**/storage/backups/.gitkeep
**/storage/reports/*
!**/storage/reports/.gitkeep
**/storage/logs/*
!**/storage/logs/.gitkeep

# Environment Files & Secrets
.env
.env.*
.env.local
.env.*.local
*.env
**/.env
**/.env.*
**/.env.local
**/.env.*.local
**/*.env

# Explicitly Allow Environment Templates / Examples
!.env.example
!.env.template
!**/.env.example
!**/.env.template

# Editor & OS Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.bak
*.swp
*~
